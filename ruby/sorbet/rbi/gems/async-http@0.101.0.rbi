  # @parameter address [Addrinfo] The remote address of the peer.
  #
  # pkg:gem/async-http#lib/async/http/server.rb:58
  def accept(peer, address, task: T.unsafe(nil)); end

  # @returns [Hash] A JSON-compatible representation of this server.
  #
  # pkg:gem/async-http#lib/async/http/server.rb:38
  def as_json(*_arg0, **_arg1, &_arg2); end

  # pkg:gem/async-http#lib/async/http/server.rb:51
  def endpoint; end

  # pkg:gem/async-http#lib/async/http/server.rb:52
  def protocol; end

  # @returns [Async::Task] The task that is running the server.
  #
  # pkg:gem/async-http#lib/async/http/server.rb:78
  def run; end

  # pkg:gem/async-http#lib/async/http/server.rb:53
  def scheme; end

  # @returns [String] A JSON string representation of this server.
  #
  # pkg:gem/async-http#lib/async/http/server.rb:47
  def to_json(*_arg0, **_arg1, &_arg2); end

  class << self
    # Create a server using a block as the application handler.
    # @parameter arguments [Array] Arguments to pass to {initialize}.
    # @parameter options [Hash] Options to pass to {initialize}.
    #
    # pkg:gem/async-http#lib/async/http/server.rb:20
    def for(*arguments, **options, &block); end
  end
end

# Tracks response timing statistics including time to first byte and total duration.
