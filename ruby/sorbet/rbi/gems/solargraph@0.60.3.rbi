    # any missing gems.
    #
    #
    # @param directory [String]
    # @param out [IO, StringIO, nil] The output stream for messages
    # @param loose_unions [Boolean] See #initialize
    #
    # @return [ApiMap]
    #
    # pkg:gem/solargraph#lib/solargraph/api_map.rb:268
    def load_with_cache(directory, out = T.unsafe(nil), loose_unions: T.unsafe(nil)); end

    # @param out [StringIO, IO, nil] output stream for logging
    # @return [void]
    #
    # pkg:gem/solargraph#lib/solargraph/api_map.rb:43
    def reset_core(out: T.unsafe(nil)); end
  end
end

