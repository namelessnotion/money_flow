  def path; end

  # @return [::Symbol]
  #
  # pkg:gem/solargraph#lib/solargraph/pin/method_alias.rb:11
  def scope; end

  # pkg:gem/solargraph#lib/solargraph/pin/method_alias.rb:29
  def to_rbs; end

  # pkg:gem/solargraph#lib/solargraph/pin/method_alias.rb:25
  def visibility; end
end

# pkg:gem/solargraph#lib/solargraph/pin/namespace.rb:7
class Solargraph::Pin::Namespace < ::Solargraph::Pin::Closure
  # @param type [::Symbol] :class or :module
