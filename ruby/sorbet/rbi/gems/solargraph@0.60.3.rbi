  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/source/change.rb:14
  def new_text; end

  # @return [Range, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/source/change.rb:11
  def range; end

  # Repair an update by replacing the new text with similarly formatted
  # whitespace.
  #
  # @param text [String] The text to be changed.
  # @return [String] The updated text.
  #
  # pkg:gem/solargraph#lib/solargraph/source/change.rb:57
  def repair(text); end

  # Write the change to the specified text.
  #
  # @param text [String] The text to be changed.
  # @param nullable [Boolean] If true, minor changes that could generate
  #   syntax errors will be repaired.
  # @return [String] The updated text.
  #
  # pkg:gem/solargraph#lib/solargraph/source/change.rb:30
  def write(text, nullable = T.unsafe(nil)); end

  private

  # @param text [String]
  # @param insert [String]
  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/source/change.rb:80
  def commit(text, insert); end
end

# Information about a single Position in a Source, including the
# word located there.
#
# pkg:gem/solargraph#lib/solargraph/source/cursor.rb:8
class Solargraph::Source::Cursor
  # @param source [Source]
  # @param position [Position, Array(Integer, Integer)]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:17
  def initialize(source, position); end

  # True if the statement at the cursor is an argument to a previous
  # method.
  #
  # Given the code `process(foo)`, a cursor pointing at `foo` would
  # identify it as an argument being passed to the `process` method.
  #
  # If #argument? is true, the #recipient method will return a cursor that
  # points to the method receiving the argument.
  #
  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:96
  def argument?; end

  # @return [Chain]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:82
  def chain; end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:102
  def comment?; end

  # The part of the word after the current position. Given the text
  # `foo.bar`, the end_of_word at position (0,6) is `r`.
  #
  # @return [String]
  # @sg-ignore Need to add nil check here
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:58
  def end_of_word; end

  # @return [String, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:23
  def filename; end

  # @return [AST::Node]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:134
  def node; end

  # @return [Position]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:139
  def node_position; end

  # @return [Integer]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:160
  def offset; end

  # @return [Position]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:10
  def position; end

  # The range of the word at the current position.
  #
  # @return [Range]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:73
  def range; end

  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:131
  def receiver; end

  # Get a cursor pointing to the method that receives the current statement
  # as an argument.
  #
  # @return [Cursor, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:115
  def recipient; end

  # @return [Parser::AST::Node, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:155
  def recipient_node; end

  # @return [Source]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:13
  def source; end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:66
  def start_of_constant?; end

  # The part of the word before the current position. Given the text
  # `foo.bar`, the start_of_word at position(0, 6) is `ba`.
  #
  # @sg-ignore Need to add nil check here
  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:40
  def start_of_word; end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:107
  def string?; end

  # The whole word at the current position. Given the text `foo.bar`, the
  # word at position(0,6) is `bar`.
  #
  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:31
  def word; end

  private

  # A regular expression to find the end of a word from an offset.
  #
  # @return [Regexp]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:176
  def end_word_pattern; end

  # A regular expression to find the start of a word from an offset.
  #
  # @return [Regexp]
  #
  # pkg:gem/solargraph#lib/solargraph/source/cursor.rb:169
  def start_word_pattern; end
end

