    # @return [Array<Solargraph::Pin::Base>, nil]
    #
    # pkg:gem/solargraph#lib/solargraph/pin_cache.rb:198
    def load(file); end

    # @param file [String]
    # @param pins [Array<Pin::Base>]
    # @return [void]
    #
    # pkg:gem/solargraph#lib/solargraph/pin_cache.rb:215
    def save(file, pins); end

    # @param path_segments [Array<String>]
    # @return [void]
    # @param [Object, nil] out
    #
    # pkg:gem/solargraph#lib/solargraph/pin_cache.rb:226
    def uncache(*path_segments, out: T.unsafe(nil)); end

    # @return [void]
    # @param path_segments [Array<String>]
    # @param [Object, nil] out
    #
    # pkg:gem/solargraph#lib/solargraph/pin_cache.rb:236
    def uncache_by_prefix(*path_segments, out: T.unsafe(nil)); end
  end
end

# The zero-based line and column numbers of a position in a string.
#
# pkg:gem/solargraph#lib/solargraph/position.rb:6
class Solargraph::Position
  include ::Solargraph::Equality

  # @param line [Integer]
  # @param character [Integer]
  #
  # pkg:gem/solargraph#lib/solargraph/position.rb:19
  def initialize(line, character); end

  # @param other [Position]
  #
  # pkg:gem/solargraph#lib/solargraph/position.rb:25
  def <=>(other); end

  # pkg:gem/solargraph#lib/solargraph/position.rb:128
  def ==(other); end

  # @return [Integer]
  #
  # pkg:gem/solargraph#lib/solargraph/position.rb:13
  def character; end

  # pkg:gem/solargraph#lib/solargraph/position.rb:15
  def column; end

  # pkg:gem/solargraph#lib/solargraph/position.rb:45
  def inspect; end

  # @return [Integer]
  #
  # pkg:gem/solargraph#lib/solargraph/position.rb:10
  def line; end

  # Get a hash of the position. This representation is suitable for use in
  # the language server protocol.
  #
  # @return [Hash]
  #
  # pkg:gem/solargraph#lib/solargraph/position.rb:38
  def to_hash; end

  protected

  # pkg:gem/solargraph#lib/solargraph/position.rb:135
  def equality_fields; end

  class << self
    # Get a position for the specified text and offset.
    #
    # @raise [InvalidOffsetError] if the offset is outside the text range
    #
    # @param text [String]
    # @param offset [Integer]
    # @return [Position]
    #
    # pkg:gem/solargraph#lib/solargraph/position.rb:94
    def from_offset(text, offset); end

    # Get a numeric offset for the specified text and a position identified
    # by its line and character.
    #
    # @param text [String]
    # @param line [Integer]
    # @param character [Integer]
    # @return [Integer]
    #
    # pkg:gem/solargraph#lib/solargraph/position.rb:83
    def line_char_to_offset(text, line, character); end

    # A helper method for generating positions from arrays of integers. The
    # original parameter is returned if it is already a position.
    #
    # @raise [ArgumentError] if the object cannot be converted to a position.
    #
    # @param object [Position, Array(Integer, Integer)]
    # @return [Position]
    #
    # pkg:gem/solargraph#lib/solargraph/position.rb:122
    def normalize(object); end

    # Get a numeric offset for the specified text and position.
    #
    # @param text [String]
    # @param position [Position]
    # @return [Integer]
    #
    # pkg:gem/solargraph#lib/solargraph/position.rb:54
    def to_offset(text, position); end
  end
end

# A pair of Positions that compose a section of text in code.
#
# pkg:gem/solargraph#lib/solargraph/range.rb:6
class Solargraph::Range
  include ::Solargraph::Equality

  # @param start [Position]
  # @param ending [Position]
  #
  # pkg:gem/solargraph#lib/solargraph/range.rb:17
  def initialize(start, ending); end

  # @param other [BasicObject]
  #
  # pkg:gem/solargraph#lib/solargraph/range.rb:23
  def <=>(other); end

  # pkg:gem/solargraph#lib/solargraph/range.rb:98
  def ==(other); end

  # True if the specified position is inside the range.
  #
  # @param position [Position, Array(Integer, Integer)]
  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/range.rb:47
  def contain?(position); end

  # @return [Position]
  #
  # pkg:gem/solargraph#lib/solargraph/range.rb:13
  def ending; end

  # True if the range contains the specified position and the position does not precede it.
  #
  # @param position [Position, Array(Integer, Integer)]
  # @sg-ignore flow sensitive typing should be able to handle redefinition
  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/range.rb:63
  def include?(position); end

  # pkg:gem/solargraph#lib/solargraph/range.rb:103
  def inspect; end

  # @return [Position]
  #
  # pkg:gem/solargraph#lib/solargraph/range.rb:10
  def start; end

  # Get a hash of the range. This representation is suitable for use in
  # the language server protocol.
  #
  # @return [Hash{Symbol => Position}]
  #
  # pkg:gem/solargraph#lib/solargraph/range.rb:36
  def to_hash; end

  protected

  # pkg:gem/solargraph#lib/solargraph/range.rb:109
  def equality_fields; end

  class << self
    # Get a range from a Parser range, usually found in
    # Parser::AST::Node#location#expression.
    #
    # @param expr [Parser::Source::Range]
    # @return [Range]
    #
    # pkg:gem/solargraph#lib/solargraph/range.rb:94
    def from_expr(expr); end

    # Get a range from a node.
    #
    # @param node [::Parser::AST::Node]
    # @return [Range, nil]
    #
    # pkg:gem/solargraph#lib/solargraph/range.rb:84
    def from_node(node); end

    # Create a range from a pair of lines and characters.
    #
    # @param l1 [Integer] Starting line
    # @param c1 [Integer] Starting character
    # @param l2 [Integer] Ending line
    # @param c2 [Integer] Ending character
    # @return [Range]
    #
    # pkg:gem/solargraph#lib/solargraph/range.rb:76
    def from_to(l1, c1, l2, c2); end
  end
end

# pkg:gem/solargraph#lib/solargraph/rbs_map.rb:8
class Solargraph::RbsMap
  include ::Solargraph::Logging

  # @param library [String]
  # @param version [String, nil]
  # @param rbs_collection_config_path [String, Pathname, nil]
  # @param rbs_collection_paths [Array<Pathname, String>]
  # @param out [StringIO, IO, nil] where to log messages
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:26
  def initialize(library, version = T.unsafe(nil), rbs_collection_config_path: T.unsafe(nil), rbs_collection_paths: T.unsafe(nil), out: T.unsafe(nil)); end

  # @return [String] representing the version of the RBS info fetched
  #   for the given library.  Must change when the RBS info is
  #   updated upstream for the same library and version.  May change
  #   if the config for where information comes form changes.
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:68
  def cache_key; end

  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:19
  def library; end

  # @return [RBS::EnvironmentLoader]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:60
  def loader; end

  # @generic T
  # @param path [String]
  # @param klass [Class<generic<T>>]
  #
  # @sg-ignore Need to be able to resolve generics based on a
  #   Class<generic<T>> param
  # @return [generic<T>, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:141
  def path_pin(path, klass = T.unsafe(nil)); end

  # @param path [String]
  # @return [Array<Pin::Base>]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:148
  def path_pins(path); end

  # @param out [IO, nil] where to log messages
  # @return [Array<Pin::Base>]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:126
  def pins(out: T.unsafe(nil)); end

  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:19
  def rbs_collection_config_path; end

  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:19
  def rbs_collection_paths; end

  # @return [RBS::Repository]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:157
  def repository; end

  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:152
  def resolved?; end

  private

  # @param loader [RBS::EnvironmentLoader]
  # @param library [String]
  # @param version [String, nil] the version of the library to load, or nil for any
  # @param out [StringIO, IO, nil] where to log messages
  # @return [Boolean] true if adding the library succeeded
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:191
  def add_library(loader, library, version, out: T.unsafe(nil)); end

  # @return [Conversions]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:175
  def conversions; end

  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:179
  def resolve_dependencies?; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:203
  def short_name; end

  class << self
    # @param gemspec [Gem::Specification, Bundler::LazySpecification]
    # @param rbs_collection_path [String, Pathname, nil]
    # @param rbs_collection_config_path [String, Pathname, nil]
    # @return [RbsMap]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:108
    def from_gemspec(gemspec, rbs_collection_path, rbs_collection_config_path); end

    # @param library [String]
    # @return [RbsMap]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:168
    def load(library); end

    # @param cache_key [String, nil]
    # @return [String, nil] a description of the source of the RBS info
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_map.rb:44
    def rbs_source_desc(cache_key); end
  end
end

