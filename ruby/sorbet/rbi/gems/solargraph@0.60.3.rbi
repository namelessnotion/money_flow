  # @param facts_by_pin [Hash{Pin::BaseVariable => Array<Hash{:type, :not_type => ComplexType}>}]
  # @param presences [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:225
  def process_facts(facts_by_pin, presences); end

  # @param isa_node [Parser::AST::Node]
  # @param true_presences [Array<Range>]
  # @param false_presences [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:315
  def process_isa(isa_node, true_presences, false_presences); end

  # @param nilp_node [Parser::AST::Node]
  # @param true_presences [Array<Range>]
  # @param false_presences [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:348
  def process_nilp(nilp_node, true_presences, false_presences); end

  # @return [void]
  # @param node [Parser::AST::Node]
  # @param true_presences [Array<Range>]
  # @param false_presences [Array<Range>]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:411
  def process_variable(node, true_presences, false_presences); end

  # @param node [Parser::AST::Node]
  #
  # @return [String, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:439
