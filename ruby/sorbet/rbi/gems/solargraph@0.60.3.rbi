# Definitions of type checking rules to be performed at various levels
#
# pkg:gem/solargraph#lib/solargraph/type_checker/rules.rb:7
class Solargraph::TypeChecker::Rules
  # @param level [Symbol]
  # @param overrides [Hash{Symbol => Symbol}]
  #
  # pkg:gem/solargraph#lib/solargraph/type_checker/rules.rb:24
