  # Prepare multiple folders.
  #
  # @param array [Array<Hash{String => String}>]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:316
  def prepare_folders(array); end

  # Called by adapter, to handle the request
  # @param request [Hash]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:89
  def process(request); end

