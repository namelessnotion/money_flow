Solargraph::ComplexType::SYMBOL = T.let(T.unsafe(nil), Solargraph::ComplexType)

# Methods for accessing type data available from
# both ComplexType and UniqueType.
#
# @abstract This mixin relies on these -
#   instance variables:
#     @name: String
#     @subtypes: Array<ComplexType>
#     @rooted: boolish
#   methods:
#     transform()
#     all_params()
#     rooted?()
#     can_root_name?()
#
# pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:18
module Solargraph::ComplexType::TypeMethods
  # @param other [Object]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:206
  def ==(other); end

  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:70
  def defined?; end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:52
  def duck_type?; end

  # @yieldparam [UniqueType]
  # @return [void]
  # @overload each_unique_type()
  #   @return [Enumerator<UniqueType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:235
  def each_unique_type(&block); end

  # @param generics_to_erase [Enumerable<String>]
  # @return [self]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:92
  def erase_generics(generics_to_erase); end

  # Variance of the type ignoring any type parameters
  # @return [Symbol]
  # @param situation [Symbol] The situation in which the variance is being considered.
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:81
  def erased_variance(situation = T.unsafe(nil)); end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:122
  def fixed_parameters?; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:182
  def generate_substring_from(&to_str); end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:127
  def hash_parameters?; end

  # Whether this is an RBS interface like _ToAry or Hash::_Key.
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:47
  def interface?; end

  # @return [Array<ComplexType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:137
  def key_types; end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:117
  def list_parameters?; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:31
  def name; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:142
  def namespace; end

  # @return [self]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:152
  def namespace_type; end

  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:57
  def nil_type?; end

  # @return [Symbol, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:107
  def parameters_type; end

  # Generate a ComplexType that fully qualifies this type's namespaces.
  #
  # @param api_map [ApiMap] The ApiMap that performs qualification
  # @param context [String] The namespace from which to resolve names
  # @return [self, ComplexType, UniqueType] The generated ComplexType
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/type_methods.rb:217
  def qualify(api_map, context = T.unsafe(nil)); end

