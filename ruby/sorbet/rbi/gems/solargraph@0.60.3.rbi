  def enclosing_breakable_pin; end

  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:468
  def enclosing_compound_statement_pin; end

  # @param variable_name [String]
  # @param position [Position]
  #
  # @sg-ignore Solargraph::Parser::FlowSensitiveTyping#find_var
  #   return type could not be inferred
  # @return [Solargraph::Pin::LocalVariable, Solargraph::Pin::InstanceVariable, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:300
  def find_var(variable_name, position); end

  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:468
  def ivars; end

  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:468
  def locals; end

  # @param bang_node [Parser::AST::Node]
  # @return [Array(String, String), nil]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:376
  def parse_bang(bang_node); end

  # @param call_node [Parser::AST::Node]
  # @param method_name [Symbol]
  # @return [Array(String, String), nil] Tuple of rgument to
  #   function, then receiver of function if it's a variable,
