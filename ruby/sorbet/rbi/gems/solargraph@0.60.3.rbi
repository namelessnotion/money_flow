  # @param expression_node [Parser::AST::Node]
  # @param true_ranges [Array<Range>]
  # @param false_ranges [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:248
