    # @param type [RBS::Types::Bases::Base]
    # @return [ComplexType]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_translator.rb:17
    def to_complex_type(type); end

    # @param param_type [RBS::Types::Function::Param]
    # @param name [String]
    # @param decl [Symbol]
    # @param closure [Pin::Closure]
    # @return [Pin::Parameter]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_translator.rb:27
    def to_parameter_pin(param_type, name, decl, closure); end

    # @param method_type [RBS::MethodType]
    # @param closure [Pin::Closure]
    # @param parameter_names [Array<String>]
    # @return [Array<Pin::Parameter>]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_translator.rb:42
    def to_parameter_pins(method_type, closure, parameter_names = T.unsafe(nil)); end

    # @param location [RBS::Location, nil]
    # @return [Solargraph::Location, nil]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_translator.rb:114
    def to_sg_location(location); end

    # @param method_type [RBS::MethodType]
    # @param closure [Pin::Closure]
    # @param parameter_names [Array<String>]
    # @return [Pin::Signature]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_translator.rb:81
    def to_signature(method_type, closure, parameter_names = T.unsafe(nil)); end

    private

    # @param type_name [RBS::TypeName]
    # @param type_args [Enumerable<RBS::Types::Bases::Base>]
    # @return [ComplexType::UniqueType]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_translator.rb:193
    def build_type(type_name, type_args = T.unsafe(nil)); end

    # @param type_name [RBS::TypeName]
    # @param type_args [Enumerable<RBS::Types::Bases::Base>]
    # @return [String]
    #
    # pkg:gem/solargraph#lib/solargraph/rbs_translator.rb:186
