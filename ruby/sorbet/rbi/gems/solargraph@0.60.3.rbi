class Solargraph::Workspace::Gemspecs
  include ::Solargraph::Logging

  # @param directory [String, nil] If nil, assume no bundle is present
  # @param preferences [Array<Gem::Specification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:16
  def initialize(directory, preferences: T.unsafe(nil)); end

  # Returns all gemspecs directly depended on by this workspace's
  # bundle (does not include transitive dependencies).
  #
  # @return [Array<Gem::Specification, Bundler::LazySpecification, Bundler::StubSpecification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:147
  def all_gemspecs_from_bundle; end

  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:12
  def directory; end

  # @param gemspec [Gem::Specification]
  # @param out[IO, nil] output stream for logging
  #
  # @return [Array<Gem::Specification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:119
  def fetch_dependencies(gemspec, out: T.unsafe(nil)); end

  # @param name [String]
  # @param version [String, nil]
  # @param out [IO, nil] output stream for logging
  #
  # @return [Gem::Specification, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:102
  def find_gem(name, version = T.unsafe(nil), out: T.unsafe(nil)); end

  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:12
  def preferences; end

  # Take the path given to a 'require' statement in a source file
  # and return the Gem::Specifications which will be brought into
  # scope with it, so we can load pins for them.
  #
  # @param require [String] The string sent to 'require' in the code to resolve, e.g. 'rails', 'bundler/require'
  # @return [::Array<Gem::Specification>, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:37
  def resolve_require(require); end

  # @param stdlib_name [String]
  #
  # @return [Array<String>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:92
  def stdlib_dependencies(stdlib_name); end

  private

  # @sg-ignore return type could not be inferred
  # @return [Array<Gem::Specification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:324
  def all_gemspecs_from_external_bundle; end

  # @return [Array<Gem::Specification, Bundler::LazySpecification, Bundler::StubSpecification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:232
