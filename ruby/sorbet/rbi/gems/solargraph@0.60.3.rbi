# A container for type data based on YARD type tags.
#
# pkg:gem/solargraph#lib/solargraph/complex_type.rb:6
class Solargraph::ComplexType
  include ::Solargraph::Equality

  # @param types [Array<UniqueType, ComplexType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:17
  def initialize(types = T.unsafe(nil)); end

  # @param index [Integer]
  # @return [UniqueType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:136
  def [](index); end

  # @yieldparam [UniqueType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:266
  def all?(&block); end

  # @return [Array<ComplexType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:332
  def all_params; end

  # every type and subtype in this union have been resolved to be
  # fully qualified
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:349
  def all_rooted?; end

  # @yieldparam [UniqueType]
  # @yieldreturn [Boolean]
  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:273
  def any?(&block); end

  # @param api_map [ApiMap]
  # @param expected [ComplexType, ComplexType::UniqueType]
  # @param situation [:method_call, :return_type, :assignment]
  # @param rules [Array<:allow_subtype_skew, :allow_empty_params, :allow_reverse_match, :allow_any_match, :allow_undefined, :allow_unresolved_generic, :allow_unmatched_interface>]
  #
  #   allow_subtype_skew: if not provided, check if any subtypes of
  #     the expected type match the inferred type
  #
  #   allow_reverse_match: check if any subtypes
  #     of the expected type match the inferred type
  #
  #   allow_empty_params: allow a general inferred type without
  #     parameters to conform to a more specific expected type
  #
  #   allow_any_match: any unique type matched in the inferred
  #     qualifies as a match
  #
  #   allow_undefined: treat undefined as a wildcard that matches
  #     anything
  #
  # @param variance [:invariant, :covariant, :contravariant]
  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:223
  def conforms_to?(api_map, expected, situation, rules = T.unsafe(nil), variance: T.unsafe(nil)); end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:197
  def desc; end

  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:191
  def downcast_to_literal_if_possible; end

  # @param api_map [ApiMap]
  # @param expected [ComplexType, UniqueType]
  # @param inferred [ComplexType, UniqueType]
  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:249
  def duck_types_match?(api_map, expected, inferred); end

  # @yieldparam [UniqueType]
  # @return [Enumerable<UniqueType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:93
  def each(&block); end

  # @yieldparam [UniqueType]
  # @return [void]
  # @overload each_unique_type()
  #   @return [Enumerator<UniqueType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:101
  def each_unique_type(&block); end

  # @param other [ComplexType, UniqueType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:354
  def erased_version_of?(other); end

  # @param exclude_types [ComplexType, nil]
  # @param api_map [ApiMap]
  # @return [ComplexType, self]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:371
  def exclude(exclude_types, api_map); end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:301
  def expand(named_types); end

  # @return [UniqueType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:60
  def first; end

  # @return [self]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:306
  def force_rooted; end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:281
  def generic?; end

  # @see https://en.wikipedia.org/wiki/Intersection_type
  #
  # @param intersection_type [ComplexType, ComplexType::UniqueType, nil]
  # @param api_map [ApiMap]
  # @return [self, ComplexType::UniqueType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:384
  def intersect_with(intersection_type, api_map); end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:366
  def items; end

  # @return [Integer]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:125
  def length; end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:186
  def literal?; end

  # @yieldparam [UniqueType]
  # @yieldreturn [UniqueType]
  # @return [Array<UniqueType>]
  # @sg-ignore Declared return type
  #   ::Array<::Solargraph::ComplexType::UniqueType> does not match
  #   inferred type ::Array<::Proc> for Solargraph::ComplexType#map
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:87
  def map(&block); end

  # @param name [Symbol]
  #
  # @return [Object, nil]
  # @param [Array<Object>] args
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:160
  def method_missing(name, *args, &block); end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:146
  def namespace; end

  # @return [Array<String>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:152
  def namespaces; end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:320
  def nullable?; end

  # @param api_map [ApiMap]
  # @param gates [Array<String>]
  #
  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:36
  def qualify(api_map, *gates); end

  # @param new_name [String, nil]
  # @param make_rooted [Boolean, nil]
  # @param new_key_types [Array<ComplexType>, nil]
  # @param make_rooted [Boolean, nil]
  # @param new_subtypes [Array<ComplexType>, nil]
  # @return [self]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:115
  def recreate(new_name: T.unsafe(nil), make_rooted: T.unsafe(nil), new_key_types: T.unsafe(nil), new_subtypes: T.unsafe(nil)); end

  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:337
  def reduce_class_type; end

  # @param definitions [Pin::Namespace, Pin::Method]
  # @param context_type [ComplexType]
  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:315
  def resolve_generics(definitions, context_type); end

  # @param generics_to_resolve [Enumerable<String>]]
  # @param context_type [ComplexType, ComplexType::UniqueType, nil]
  # @param resolved_generic_values [Hash{String => ComplexType}] Added to as types are encountered or resolved
  # @return [self]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:50
  def resolve_generics_from_context(generics_to_resolve, context_type, resolved_generic_values: T.unsafe(nil)); end

  # every top-level type has resolved to be fully qualified; see
  # #all_rooted? to check their subtypes as well
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:362
  def rooted?; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:261
  def rooted_tags; end

  # @return [Array<UniqueType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:141
  def select(&block); end

  # @param dst [ComplexType, ComplexType::UniqueType]
  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:73
  def self_to_type(dst); end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:277
  def selfy?; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:182
  def simple_tags; end

  # @return [self]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:286
  def simplify_literals; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:177
  def tags; end

  # @return [Array<UniqueType>]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:130
  def to_a; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:65
  def to_rbs; end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:172
  def to_s; end

  # @param new_name [String, nil]
  # @yieldparam t [UniqueType]
  # @yieldreturn [UniqueType]
  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:294
  def transform(new_name = T.unsafe(nil), &transform_type); end

  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:325
  def without_nil; end

  protected

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:417
  def bottom?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:404
  def equality_fields; end

  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:409
  def reduce_object; end

  private

  # @todo This is a quick and dirty hack that forces `self` keywords
  #   to reference an instance of their class and never the class itself.
  #   This behavior may change depending on which result is expected
  #   from YARD conventions. See https://github.com/lsegal/yard/issues/1257
  # @param dst [String]
  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:557
  def reduce_class(dst); end

  # @param name [Symbol]
  # @param include_private [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type.rb:168
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end

  class << self
    # Parse type strings into a ComplexType.
    #
    # @example
    #   ComplexType.parse 'String', 'Foo', 'nil' #=> [String, Foo, nil]
    #
    # @param partial [Boolean] if true, method is receiving a string
    #   that will be used inside another ComplexType.  It returns
    #   arrays of ComplexTypes instead of a single cohesive one.
    #   Consumers should not need to use this parameter; it should
    #   only be used internally.
    # @param strings [Array<String>] The type definitions to parse
    # @return [ComplexType]
    # # @overload parse(*strings, partial: false)
    # #  @todo Need ability to use a literal true as a type below
    # #  @param partial [Boolean] True if the string is part of a another type
    # #  @return [Array<UniqueType>]
    # @sg-ignore To be able to select the right signature above,
    #   Chain::Call needs to know the decl type (:arg, :optarg,
    #   :kwarg, etc) of the arguments given, instead of just having
    #   an array of Chains as the arguments.
    #
    # pkg:gem/solargraph#lib/solargraph/complex_type.rb:442
    def parse(*strings, partial: T.unsafe(nil)); end

    # @param strings [Array<String>]
    # @return [ComplexType]
    #
    # pkg:gem/solargraph#lib/solargraph/complex_type.rb:532
    def try_parse(*strings); end
  end
end

# pkg:gem/solargraph#lib/solargraph/complex_type.rb:546
Solargraph::ComplexType::BOOLEAN = T.let(T.unsafe(nil), Solargraph::ComplexType)

# pkg:gem/solargraph#lib/solargraph/complex_type.rb:547
Solargraph::ComplexType::BOT = T.let(T.unsafe(nil), Solargraph::ComplexType)

# Checks whether a type can be used in a given situation
#
# pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:6
class Solargraph::ComplexType::Conformance
  # @param api_map [ApiMap]
  # @param inferred [ComplexType::UniqueType]
  # @param expected [ComplexType::UniqueType]
  # @param situation [:method_call, :return_type]
  # @param rules [Array<:allow_subtype_skew, :allow_empty_params, :allow_reverse_match,
  #   :allow_any_match, :allow_undefined, :allow_unresolved_generic,
  #   :allow_unmatched_interface>]
  # @param variance [:invariant, :covariant, :contravariant]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:15
  def initialize(api_map, inferred, expected, situation = T.unsafe(nil), rules = T.unsafe(nil), variance: T.unsafe(nil)); end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:37
  def conforms_to_unique_type?; end

  private

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:173
  def api_map; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:94
  def can_strip_expected_parameters?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:98
  def conforms_via_reverse_match?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:85
  def conforms_via_stripped_expected_parameters?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:106
  def erased_type_conforms?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:173
  def expected; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:89
  def ignore_interface?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:173
  def inferred; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:130
  def key_types_conform?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:81
  def only_inferred_parameters?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:173
  def rules; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:173
  def situation; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:146
  def subtypes_conform?; end

  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:173
  def variance; end

  # @return [self]
  # @param inferred [ComplexType::UniqueType]
  # @param expected [ComplexType::UniqueType]
  #
  # pkg:gem/solargraph#lib/solargraph/complex_type/conformance.rb:169
  def with_new_types(inferred, expected); end
end

# pkg:gem/solargraph#lib/solargraph/complex_type.rb:7
Solargraph::ComplexType::GENERIC_TAG_NAME = T.let(T.unsafe(nil), String)

