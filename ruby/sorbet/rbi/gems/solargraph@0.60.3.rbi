    # @param yard_pins [Array<Pin::Base>]
    # @param rbs_pins [Array<Pin::Base>]
    #
    # @return [Array<Pin::Base>]
    #
    # pkg:gem/solargraph#lib/solargraph/gem_pins.rb:49
