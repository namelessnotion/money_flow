  # @return [Array<Gem::Specification, Bundler::LazySpecification, Bundler::StubSpecification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:249
  def auto_required_gemspecs_from_bundler; end

  # @return [Array<Gem::Specification, Bundler::LazySpecification, Bundler::StubSpecification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:272
  def auto_required_gemspecs_from_external_bundle; end

  # @return [Array<Gem::Specification, Bundler::LazySpecification, Bundler::StubSpecification>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:262
  def auto_required_gemspecs_from_this_bundle; end

  # @param gemspec [Gem::Specification]
  # @param version [String]
  # @return [Gem::Specification]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:364
  def change_gemspec_version(gemspec, version); end

  # @param gemspec [Gem::Specification]
  #
  # @return [Gem::Specification]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:354
  def gemspec_or_preference(gemspec); end

  # @sg-ignore need boolish support for ? methods
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:221
  def in_this_bundle?; end

  # @param gemspec [Gem::Specification]
  # @return [Array<Gem::Dependency>]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:290
  def only_runtime_dependencies(gemspec); end

  # @return [Hash{String => Gem::Specification}]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:347
  def preference_map; end

  # @param command [String] The expression to evaluate in the external bundle
  # @sg-ignore Need a JSON type
  # @yield [undefined, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/workspace/gemspecs.rb:203
  def query_external_bundle(command); end

  # @todo Should this be using Gem::SpecFetcher and pull them automatically?
  #
  # @param name [String]
