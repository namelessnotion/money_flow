  # @param id [Integer]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:65
  def cancel(id); end

  # True if the host received a request to cancel the method with the
  # specified ID.
  #
  # @param id [Integer]
  # @return [Boolean]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:74
  def cancel?(id); end

  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:695
  def catalog; end

  # Update a document from the parameters of a textDocument/didChange
  # method.
  #
  # @param params [Hash]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:250
  def change(params); end

  # Delete the specified ID from the list of cancelled IDs if it exists.
  #
  # @param id [Integer]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:82
  def clear(id); end

  # @return [Hash{String => Hash{String => Boolean}}]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:701
  def client_capabilities; end

  # @return [Hash{String => Hash{String => Boolean}}]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:24
  def client_capabilities=(_arg0); end

  # pkg:gem/solargraph#lib/solargraph/language_server/host.rb:705
