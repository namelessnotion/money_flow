  # @param bang_node [Parser::AST::Node]
  # @param true_presences [Array<Range>]
  # @param false_presences [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:385
