# Functions for converting RBS declarations to Solargraph pins
#
# pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:9
class Solargraph::RbsMap::Conversions
  include ::Solargraph::Logging

  # @param loader [RBS::EnvironmentLoader]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:26
  def initialize(loader:); end

  # @return [RBS::EnvironmentLoader]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:33
  def loader; end

  # @return [Array<Pin::Base>]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:36
  def pins; end

  private

  # @param decl [RBS::AST::Declarations::Class, RBS::AST::Declarations::Module]
  # @param namespace [Pin::Namespace, nil]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:794
  def add_mixins(decl, namespace); end

  # @param decl [RBS::AST::Members::Alias]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:745
  def alias_to_pin(decl, closure); end

  # @param decl [RBS::AST::Members::AttrAccessor]
  # @param closure [Pin::Namespace]
  # @param context [Context]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:644
  def attr_accessor_to_pin(decl, closure, context); end

  # @param decl [RBS::AST::Members::AttrReader,RBS::AST::Members::AttrAccessor]
  # @param closure [Pin::Namespace]
  # @param context [Context]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:585
  def attr_reader_to_pin(decl, closure, context); end

  # @param decl [RBS::AST::Members::AttrWriter, RBS::AST::Members::AttrAccessor]
  # @param closure [Pin::Namespace]
  # @param context [Context]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:611
  def attr_writer_to_pin(decl, closure, context); end

  # @param type_name [RBS::TypeName]
  # @param type_args [Enumerable<RBS::Types::Bases::Base>]
  # @return [ComplexType::UniqueType]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:781
  def build_type(type_name, type_args = T.unsafe(nil)); end

  # @param decl [RBS::AST::Members::MethodDefinition, RBS::AST::Members::AttrReader,
  #   RBS::AST::Members::AttrWriter, RBS::AST::Members::AttrAccessor]
  # @param closure [Pin::Closure]
  # @param context [Context]
  # @param scope [Symbol] :instance or :class
  # @param name [String] The name of the method
  # @return [Symbol]
  # @sg-ignore Declared return type ::Symbol does not match inferred type
  #   ::Symbol, :public, :private, nil for Solargraph::RbsMap::Conversions#calculate_method_visibility
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:464
  def calculate_method_visibility(decl, context, closure, scope, name); end

  # @param decl [RBS::AST::Members::ClassInstanceVariable]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:685
  def civar_to_pin(decl, closure); end

  # @param decl [RBS::AST::Declarations::ClassAlias]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:375
  def class_alias_decl_to_pin(decl); end

  # @param decl [RBS::AST::Declarations::Class]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:252
  def class_decl_to_pin(decl); end

  # @param decl [RBS::AST::Declarations::Constant]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:394
  def constant_decl_to_pin(decl); end

  # @param decl [RBS::AST::Declarations::Base]
  # @param closure [Pin::Closure]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:57
  def convert_decl_to_pin(decl, closure); end

  # @param member [RBS::AST::Members::Base,RBS::AST::Declarations::Base]
  # @param closure [Pin::Namespace]
  # @param context [Context]
  # @return [Context]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:190
  def convert_member_to_pin(member, closure, context); end

  # @param decl [RBS::AST::Declarations::Module,RBS::AST::Declarations::Class,RBS::AST::Declarations::Interface]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:181
  def convert_members_to_pins(decl, closure); end

  # @param decl [RBS::AST::Declarations::Module::Self]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:165
  def convert_self_type_to_pins(decl, closure); end

  # @param decl [RBS::AST::Declarations::Module]
  # @param module_pin [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:124
  def convert_self_types_to_pins(decl, module_pin); end

  # @param fqns [String]
  # @param type [ComplexType, ComplexType::UniqueType]
  # @param comments [String, nil]
  # @param decl [RBS::AST::Declarations::ClassAlias,
  #   RBS::AST::Declarations::Constant,
  #   RBS::AST::Declarations::ModuleAlias]
  # @param base [String, nil] Optional conversion of tag to
  #   base<tag> - valid values are Class and Module
  #
  # @return [Solargraph::Pin::Constant]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:347
  def create_constant(fqns, type, comments, decl, base = T.unsafe(nil)); end

  # @param decl [RBS::AST::Members::ClassVariable]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:668
  def cvar_to_pin(decl, closure); end

  # @param decl [RBS::AST::Members::Extend]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:731
  def extend_to_pin(decl, closure); end

  # Extract a ComplexType from a MethodType's return type.
  #
  # This method will convert type aliases to concrete types.
  #
  # @param type [RBS::MethodType]
  # @return [ComplexType]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:772
  def extract_method_type_return_type(type, implicit_nil); end

  # fqns names are implicitly fully qualified - they are relative
  # to the root namespace and are not prefixed with ::
  #
  # @param type_name [RBS::TypeName]
  #
  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:154
  def fqns(type_name); end

  # @param decl [RBS::AST::Declarations::Global]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:401
  def global_decl_to_pin(decl); end

  # @param decl [RBS::AST::Members::Include]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:702
  def include_to_pin(decl, closure); end

  # @param decl [RBS::AST::Declarations::Interface]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:298
  def interface_decl_to_pin(decl); end

  # @param decl [RBS::AST::Members::InstanceVariable]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:652
  def ivar_to_pin(decl, closure); end

  # @param loader [RBS::EnvironmentLoader]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:43
  def load_environment_to_pins(loader); end

  # @param location [RBS::Location, nil]
  # @return [Solargraph::Location, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:561
  def location_decl_to_pin_location(location); end

  # @param decl [RBS::AST::Members::MethodDefinition]
  # @param closure [Pin::Closure]
  # @param context [Context]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:486
  def method_def_to_pin(decl, closure, context); end

  # @param decl [RBS::AST::Members::MethodDefinition]
  # @param pin [Pin::Method]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:540
  def method_def_to_sigs(decl, pin); end

  # @param decl [RBS::AST::Declarations::ModuleAlias]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:384
  def module_alias_decl_to_pin(decl); end

  # @param decl [RBS::AST::Declarations::Module]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:318
  def module_decl_to_pin(decl); end

  # @param type [RBS::MethodType,RBS::Types::Block]
  # @param pin [Pin::Method]
  # @param implicit_nil [Boolean]
  # @return [Array(Array<Pin::Parameter>, ComplexType)]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:574
  def parts_of_function(type, pin, implicit_nil); end

  # @param decl [RBS::AST::Members::Prepend]
  # @param closure [Pin::Namespace]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:717
  def prepend_to_pin(decl, closure); end

  # rooted names (namespaces) use the prefix of :: when they are
  # relative to the root namespace, or not if they are relative to
  # the current namespace.
  #
  # @param type_name [RBS::TypeName]
  #
  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:143
  def rooted_name(type_name); end

  # Pull the name of type variables for a generic - not the
  # values, the names (e.g., T, U, V).  As such, "rooting" isn't a
  # thing, these are all in the global namespace.
  #
  # @param decl [RBS::AST::Declarations::Class, RBS::AST::Declarations::Interface,
  #   RBS::AST::Declarations::Module, RBS::MethodType]
  #
  # @return [Array<String>]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:246
  def type_parameter_names(decl); end
end

# A container for tracking the current context of the RBS conversion
# process, e.g., what visibility is declared for methods in the current
# scope
#
# pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:16
class Solargraph::RbsMap::Conversions::Context
  # @param visibility [Symbol]
  #
  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:20
  def initialize(visibility = T.unsafe(nil)); end

  # pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:17
  def visibility; end
end

# @type [Hash{String => String}]
#
# pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:129
Solargraph::RbsMap::Conversions::RBS_TO_CLASS = T.let(T.unsafe(nil), Hash)

# pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:757
Solargraph::RbsMap::Conversions::RBS_TO_YARD_TYPE = T.let(T.unsafe(nil), Hash)

# Visibility overrides that will allow the Solargraph project
# and plugins to pass typechecking using SOLARGRAPH_ASSERTS=on,
# so that we can detect any regressions/issues elsewhere in the
# visibility logic.
#
# These should either reflect a bug upstream in the RBS
# definitions, or include a @todo indicating what needs to be
# fixed in Solargraph to properly understand it.
#
# @todo PR these fixes upstream and list open PRs here above
#   related overrides
# @todo externalize remaining overrides into yaml file, then
#   allow that to be extended via .solargraph.yml
# @type [Hash{Array(String, Symbol, String) => Symbol}
#
# pkg:gem/solargraph#lib/solargraph/rbs_map/conversions.rb:430
Solargraph::RbsMap::Conversions::VISIBILITY_OVERRIDE = T.let(T.unsafe(nil), Hash)

# Override pins to fill gaps in RbsMap::CoreMap coverage
#
