# Progress notification handling for language server hosts.
#
# pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:9
class Solargraph::LanguageServer::Progress
  # @param title [String]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:33
  def initialize(title); end

  # @param message [String]
  # @param percentage [Integer]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:43
  def begin(message, percentage); end

  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:79
  def created?; end

  # @param message [String]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:60
  def finish(message); end

  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:83
  def finished?; end

  # @return [String, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:21
  def kind; end

  # @return [String, nil]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:24
  def message; end

  # @return [Integer]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:27
  def percentage; end

  # @param message [String]
  # @param percentage [Integer]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:52
  def report(message, percentage); end

  # @param host [Solargraph::LanguageServer::Host]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:69
  def send(host); end

  # @return [Symbol]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:30
  def status; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:18
  def title; end

  # @return [String]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:15
  def uuid; end

  private

  # @return [Hash]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:99
  def build; end

  # @return [Hash]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:110
  def build_value; end

  # @param host [Solargraph::LanguageServer::Host]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:91
  def create(host); end

  # @param host [Host]
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:125
  def keep_alive(host); end

  # @return [Thread::Mutex]
  #
  # pkg:gem/solargraph#lib/solargraph/language_server/progress.rb:138
  def mutex; end
end

