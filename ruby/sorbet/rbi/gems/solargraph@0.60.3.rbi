  # @param false_ranges [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:92
  def process_if(if_node, true_ranges = T.unsafe(nil), false_ranges = T.unsafe(nil)); end

  # @param or_node [Parser::AST::Node]
  # @param true_ranges [Array<Range>]
  # @param false_ranges [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:50
  def process_or(or_node, true_ranges = T.unsafe(nil), false_ranges = T.unsafe(nil)); end

  # @param while_node [Parser::AST::Node]
  # @param true_ranges [Array<Range>]
  # @param false_ranges [Array<Range>]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:163
  def process_while(while_node, true_ranges = T.unsafe(nil), false_ranges = T.unsafe(nil)); end

  private

  # @param pin [Pin::BaseVariable]
  # @param presence [Range]
  # @param downcast_type [ComplexType, nil]
  # @param downcast_not_type [ComplexType, nil]
  #
  # @return [void]
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:207
  def add_downcast_var(pin, presence:, downcast_type:, downcast_not_type:); end

  # @param clause_node [Parser::AST::Node, nil]
  # @sg-ignore need boolish support for ? methods
  #
  # pkg:gem/solargraph#lib/solargraph/parser/flow_sensitive_typing.rb:458
